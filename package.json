{
  "name": "projeto-legendas",
  "version": "1.0.0",
  "description": "Gerador de legendas SRT para vídeos em idiomas asiáticos (japonês, chinês) com FFmpeg + Whisper + Ollama + DeepL",
  "main": "dist/index.js",
  "scripts": {
    "start": "ts-node src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["legendas", "srt", "whisper", "ollama", "deepl", "japonês", "chinês"],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "deepl-node": "^1.28.1",
    "dotenv": "^16.4.5",
    "fluent-ffmpeg": "^2.1.3",
    "nodejs-whisper": "^0.4.1",
    "ollama": "^0.6.4"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
